{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Start Backend",
            "type": "shell",
            "command": "dotnet run --launch-profile http",
            "options": {
                "cwd": "${workspaceFolder}/backend",
                "env": {
                    "ASPNETCORE_ENVIRONMENT": "Development"
                }
            },
            "isBackground": true,
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "group": "fullstack"
            },
            "problemMatcher": {
                "owner": "dotnet",
                "pattern": {
                    "regexp": "^$"
                },
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": ".",
                    "endsPattern": "(Now listening on|Application started)"
                }
            }
        },
        {
            "label": "Stop Backend",
            "type": "shell",
            "command": "Get-NetTCPConnection -LocalPort 5171 -State Listen -ErrorAction SilentlyContinue | ForEach-Object { Stop-Process -Id $_.OwningProcess -Force -ErrorAction SilentlyContinue }; Stop-Process -Name backend -Force -ErrorAction SilentlyContinue",
            "problemMatcher": [],
            "presentation": {
                "reveal": "silent",
                "panel": "shared"
            }
        }
    ]
}
